# ============================================
# Naturalis MERN E-Commerce .gitignore
# ============================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js

# Environment variables & secrets (Never commit sensitive MongoDB credentials or JWT keys)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
*.env

# Production build outputs
dist/
build/
frontend/dist/
frontend/build/
backend/dist/
backend/build/

# Logs & Debugging
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data & temporary storage
pids
*.pid
*.seed
*.pid.lock
backend/data/*.backup.json

# Testing & Coverage
coverage/
.nyc_output/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editor & IDE Directories
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project
